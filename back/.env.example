# Server Configuration
SERVER_PORT=8080
ENVIRONMENT=development

# Database Configuration (PostgreSQL 16)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=mi_recibo
DB_SSLMODE=disable

# Alert threshold for tenant consumption spike (percentage, e.g. 20 for 20%)
CONSUMPTION_ALERT_SPIKE_THRESHOLD=20.0

# JWT Authentication
# Leave empty for the local development fallback. Set a random secret of 32+ characters in production.
JWT_SECRET=
JWT_ACCESS_TOKEN_SECONDS=5
JWT_REFRESH_TOKEN_DAYS=30
